# ─── MongoDB ─────────────────────────────────────────────────────────────────
# URI complète (recommandé : MongoDB Atlas pour le déploiement Cloud Run)
# Format : mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
# Nom de la base. Séparé de l'URI pour pouvoir cibler prod/staging avec
# la même URI Atlas.
MONGO_DB_NAME=jokkolive

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Génère avec : openssl rand -hex 32
JWT_SECRET=change_moi_avec_openssl_rand_hex_32

# ─── URLs publiques ──────────────────────────────────────────────────────────
# Domaine du dashboard (CORS autorisé). En prod, JAMAIS de wildcard.
CORS_ORIGIN=https://jokkolive.com
# URL publique de l'API (utilisée pour générer les liens de paiement)
PUBLIC_BASE_URL=https://api.jokkolive.com
# URL du front (utilisée pour générer les magic links d'auth WhatsApp)
FRONTEND_URL=https://jokkolive.com

# ─── Meta WhatsApp Business Cloud API ────────────────────────────────────────
# Récupérés dans https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-dev-console/
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
# System User token "Never expires" (cf. doc setup)
WHATSAPP_CLOUD_TOKEN=
# App Secret (Settings → Basic → "Show") — vérifie la signature HMAC du webhook
WHATSAPP_CLOUD_APP_SECRET=
# Token aléatoire que TU choisis — sera saisi dans Meta Dashboard → Webhooks
# Génère avec : openssl rand -hex 32
WHATSAPP_CLOUD_VERIFY_TOKEN=change_moi_random_secret_hex_32

# Numéro WhatsApp Business public (E.164). Affiché aux acheteurs et utilisé
# pour générer les liens wa.me partageables par les vendeurs.
WHATSAPP_BUSINESS_NUMBER=+221776583181

# ─── Admin par défaut ────────────────────────────────────────────────────────
# Créé au premier démarrage si absent.
ADMIN_PHONE=+221776583181
ADMIN_PSEUDO=admin

# ─── DiamanoPay (PSP mobile money — Wave / Orange Money) ─────────────────────
DIAMANO_PAY_TOKEN=
DIAMANO_PAY_BASE_URL=https://api.diamanopay.com
ACTIVE_PSP=diamanopay

# Frais plateforme par défaut (overridables par vendeur via /users/:id/platform-fee)
PLATFORM_FEE_FLAT=50
PLATFORM_FEE_PERCENT=0.02

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
