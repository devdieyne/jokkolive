# MongoDB (container interne)
MONGO_USER=jokkolive
MONGO_PASSWORD=mot_de_passe_tres_securise

# JWT (génère avec: openssl rand -hex 32)
JWT_SECRET=change_moi_avec_openssl_rand_hex_32

# CORS — domaine public de l'application
CORS_ORIGIN=https://jokkolive.com

# URL publique (utilisée pour générer les liens de paiement)
PUBLIC_BASE_URL=https://jokkolive.com

# WAHA — WhatsApp HTTP API
WAHA_API_KEY=change_moi_random_token
WAHA_SESSION=default
# Token secret passé en query string sur le webhook WAHA → API (openssl rand -hex 32)
WAHA_WEBHOOK_TOKEN=change_moi_random_secret_hex_32

# Admin par défaut (créé au premier démarrage si absent)
ADMIN_PHONE=+221776583181
ADMIN_PSEUDO=admin

# Numéro WhatsApp public JokkoLive (celui pairé dans WAHA, format E.164).
# Utilisé pour générer les liens wa.me partageables par les vendeurs.
WHATSAPP_BUSINESS_NUMBER=+221776583181

# Backup MongoDB
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=7
BACKUP_ON_START=0

# DiamanoPay (PSP mobile money — Wave / Orange Money)
DIAMANO_PAY_TOKEN=
DIAMANO_PAY_BASE_URL=https://api.diamanopay.com
ACTIVE_PSP=diamanopay

# Frais plateforme retenus à chaque paiement (50 XOF flat + 2%)
PLATFORM_FEE_FLAT=50
PLATFORM_FEE_PERCENT=0.02
